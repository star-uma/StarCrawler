<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>starcrawler_gui</name>
  <version>0.1.0</version>
  <description>
    Interfaz web de operacion: dibuja el robot con las cuatro orugas en su
    angulo real, velocidades, errores decodificados y graficas. Es el
    dashboard de la rama standalone leyendo de /starcrawler/state en vez
    del puerto serie.
  </description>
  <maintainer email="mariogj.03@uma.es">Mario Garcia Jimenez</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>starcrawler_common</depend>
  <depend>starcrawler_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
