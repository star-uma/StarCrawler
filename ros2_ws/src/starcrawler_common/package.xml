<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>starcrawler_common</name>
  <version>0.1.0</version>
  <description>
    Logica compartida entre paquetes de StarCrawler. De momento, la
    traduccion entre grados de encoder y radianes de elevacion, que
    estaba copiada en el simulador y en la GUI.
  </description>
  <maintainer email="mariogj.03@uma.es">Mario Garcia Jimenez</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
