<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>starcrawler_bringup</name>
  <version>0.1.0</version>
  <description>
    Arranque del robot StarCrawler: launch files del PC de a bordo, reglas
    udev para el ESP32 y servicio systemd opcional.
  </description>
  <maintainer email="mariogj.03@uma.es">Mario Garcia Jimenez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>starcrawler_description</exec_depend>
  <exec_depend>starcrawler_driver</exec_depend>
  <exec_depend>starcrawler_teleop</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
