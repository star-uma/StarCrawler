<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>starcrawler_odometry</name>
  <version>0.1.0</version>
  <description>
    Odometria de orugas a partir de la velocidad de banda que publica el
    ESP32. Separada del driver para poder probarla y sustituirla sin
    tocarlo, y para dejar sitio a fusionar una IMU mas adelante.
  </description>
  <maintainer email="mariogj.03@uma.es">Mario Garcia Jimenez</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>starcrawler_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
