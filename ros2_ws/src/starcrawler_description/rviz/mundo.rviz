Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Mundo1
        - /Apoyo1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 40
      Color: 80; 80; 80
      Line Style:
        Value: Lines
      Reference Frame: odom
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Mundo
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /mundo/marcadores
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Apoyo
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /mundo/indicadores
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Real
      Enabled: true
      Topic:
        Value: /mundo/verdad
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 1000
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 57; 135; 229
        Shaft Length: 0.12
        Shaft Radius: 0.008
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometria
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 137; 135; 129
        Shaft Length: 0.12
        Shaft Radius: 0.008
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Global Options:
    Background Color: 26; 26; 25
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3
      Pitch: 0.45
      Yaw: 0.9
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: base_link
    Saved:
      - Class: rviz_default_plugins/ThirdPersonFollower
        Name: Perfil
        Distance: 2.2
        Pitch: 0.1
        Yaw: 1.5708
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Target Frame: base_footprint
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Cenital
        Angle: 0
        Scale: 100
        X: 0
        Y: 0
        Target Frame: base_footprint
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
  Views:
    collapsed: false
