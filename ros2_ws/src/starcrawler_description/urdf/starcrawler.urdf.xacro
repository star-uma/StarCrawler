<?xml version="1.0"?>
<!--
  starcrawler.urdf.xacro
  ======================
  Modelo cinematico del robot StarCrawler: chasis + cuatro orugas basculantes.

  Convencion de la articulacion de cada oruga:
    POSITIVO = brazo LEVANTADO del suelo, 0 = oruga horizontal.
    Es la misma convencion de starcrawler_msgs y del driver, que traduce
    a los grados de encoder del firmware (180 deg = horizontal; las orugas
    FL y RR van espejadas, 360-a, como documenta el TFG).

  Cada oruga es la banda alrededor de dos poleas: la activa en el pivote (la
  que mueve el RMD, su radio es el wheel_radius de la odometria) y la pasiva
  en la punta. El chasis cuelga de tres juntas virtuales (altura, cabeceo y
  balanceo) que publica chasis_node: al bajar una oruga el chasis se levanta
  sobre ella en vez de atravesar el suelo. Con todo a cero, orugas en llano.

  DIMENSIONES: valores iniciales APROXIMADOS. Medir en el robot y ajustar aqui
  (todo son propiedades xacro, se cambia en un sitio; chasis_node las lee del
  propio URDF). Referencia: cajas envolventes de los STEP de
  ControlHORUFinalBoss/CAD (mm):
      Chasis.STEP ................. 1300 x 80 x 400
      Correa v2 (oruga) ........... 622 x 327 x 80
      Panel exterior v3 ........... 365 x 425 x 10
      SoporteGiroCorreaV13 ........ 780 x 167 x 181
      Polea pasiva Oruga v9 ....... diametro 83
      Polea Central Parte 1 ....... diametro 50
  Son piezas sueltas y la envolvente incluye geometria auxiliar: son
  orientativas, NO cotas. El modelo solo afecta a la visualizacion y (mas
  adelante) al footprint de Nav2; la conversion cmd_vel <-> dps vive en
  los parametros del driver.
-->
<robot name="starcrawler" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ─── Dimensiones ─────────────────────────────────────────────────── -->
  <xacro:property name="base_length"  value="0.60"/>   <!-- X, frente-cola -->
  <xacro:property name="base_width"   value="0.40"/>   <!-- Y, lado-lado   -->
  <xacro:property name="base_height"  value="0.10"/>   <!-- Z             -->
  <xacro:property name="base_mass"    value="20.0"/>   <!-- kg, aprox      -->

  <!-- Poleas de la oruga: activa del CAD (0.15279/2, = wheel_radius) y
       pasiva de diametro 83 -->
  <xacro:property name="pulley_radius" value="0.0764"/>
  <xacro:property name="tip_radius"    value="0.0415"/>
  <xacro:property name="arm_length"   value="0.36"/>   <!-- entre ejes de poleas -->
  <xacro:property name="arm_width"    value="0.08"/>
  <xacro:property name="arm_mass"     value="3.0"/>
  <xacro:property name="belt_thickness" value="0.012"/>

  <!-- Tramos de banda: tangentes a las dos poleas, inclinados belt_angle -->
  <xacro:property name="belt_angle"  value="${asin((pulley_radius - tip_radius) / arm_length)}"/>
  <xacro:property name="belt_length" value="${arm_length * cos(belt_angle)}"/>
  <xacro:property name="belt_x"
      value="${arm_length/2 + (pulley_radius + tip_radius - belt_thickness)/2 * sin(belt_angle)}"/>
  <xacro:property name="belt_z"
      value="${(pulley_radius + tip_radius - belt_thickness)/2 * cos(belt_angle)}"/>

  <!-- Altura del pivote sobre el suelo con las orugas en llano: la banda
       apoya bajo la polea activa -->
  <xacro:property name="pivot_height" value="${pulley_radius}"/>

  <!-- Limite de recorrido: encoder 90..270 deg -> +-90 deg de elevacion -->
  <xacro:property name="arm_limit"    value="${pi/2}"/>
  <!-- 400 pasos/rev * reductora 1:80 = 32000 pasos/rev; a ~417 pasos/s
       (semiperiodo 1200 us) salen ~4.7 deg/s = 0.082 rad/s -->
  <xacro:property name="arm_max_vel"  value="0.082"/>
  <xacro:property name="arm_effort"   value="60.0"/>

  <!-- ─── Materiales ──────────────────────────────────────────────────── -->
  <material name="sc_chasis"><color rgba="0.20 0.20 0.20 1.0"/></material>
  <material name="sc_fr">    <color rgba="0.22 0.53 0.90 1.0"/></material>
  <material name="sc_fl">    <color rgba="0.00 0.51 0.00 1.0"/></material>
  <material name="sc_rr">    <color rgba="0.84 0.32 0.51 1.0"/></material>
  <material name="sc_rl">    <color rgba="0.79 0.52 0.00 1.0"/></material>
  <material name="sc_sensor"><color rgba="0.90 0.90 0.90 1.0"/></material>

  <!-- Inercia de un prisma rectangular -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ─── Chasis ──────────────────────────────────────────────────────── -->
  <!-- base_footprint: proyeccion en el suelo, raiz para Nav2 -->
  <link name="base_footprint"/>

  <!-- Juntas virtuales del apoyo: las publica chasis_node, o mundo_node con
       un mundo cargado (entonces la altura es la del terreno). La altura se
       mide desde la de las orugas en llano, para que cero sea reposo. -->
  <joint name="chassis_lift_joint" type="prismatic">
    <parent link="base_footprint"/>
    <child link="chassis_lift_link"/>
    <origin xyz="0 0 ${pivot_height}"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="2.0" effort="0" velocity="1"/>
  </joint>
  <link name="chassis_lift_link"/>

  <joint name="chassis_pitch_joint" type="revolute">
    <parent link="chassis_lift_link"/>
    <child link="chassis_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="0" velocity="1"/>
  </joint>
  <link name="chassis_pitch_link"/>

  <joint name="chassis_roll_joint" type="revolute">
    <parent link="chassis_pitch_link"/>
    <child link="base_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="0" velocity="1"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="sc_chasis"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ─── Oruga basculante ────────────────────────────────────────────────
       x_sign: +1 delantera, -1 trasera
       y_sign: +1 izquierda,  -1 derecha  (ROS: Y positivo a la izquierda)
       El eje de giro se elige para que POSITIVO = brazo levantado en las
       cuatro orugas: delanteras giran sobre -Y, traseras sobre +Y.
       El pivote es el eje de la polea activa; chasis_node reconoce las
       poleas como los dos cilindros del link.
  -->
  <xacro:macro name="crawler" params="name x_sign y_sign material">
    <joint name="${name}_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <origin xyz="${x_sign*base_length/2} ${y_sign*(base_width/2 + arm_width/2)} 0"/>
      <axis xyz="0 ${-x_sign} 0"/>
      <limit lower="${-arm_limit}" upper="${arm_limit}"
             effort="${arm_effort}" velocity="${arm_max_vel}"/>
      <dynamics damping="0.5" friction="0.5"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${pulley_radius}" length="${arm_width}"/></geometry>
        <material name="${material}"/>
      </visual>
      <visual>
        <origin xyz="${x_sign*arm_length} 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${tip_radius}" length="${arm_width}"/></geometry>
        <material name="${material}"/>
      </visual>
      <!-- tramo de arriba y tramo de abajo de la banda -->
      <visual>
        <origin xyz="${x_sign*belt_x} 0 ${belt_z}" rpy="0 ${x_sign*belt_angle} 0"/>
        <geometry><box size="${belt_length} ${arm_width} ${belt_thickness}"/></geometry>
        <material name="${material}"/>
      </visual>
      <visual>
        <origin xyz="${x_sign*belt_x} 0 ${-belt_z}" rpy="0 ${-x_sign*belt_angle} 0"/>
        <geometry><box size="${belt_length} ${arm_width} ${belt_thickness}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="${x_sign*arm_length/2} 0 0"/>
        <geometry><box size="${arm_length} ${arm_width} ${2*pulley_radius}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${x_sign*arm_length/2} 0 0"/>
        <mass value="${arm_mass}"/>
        <inertia
          ixx="${arm_mass*(arm_width*arm_width+4*pulley_radius*pulley_radius)/12.0}" ixy="0.0" ixz="0.0"
          iyy="${arm_mass*(arm_length*arm_length+4*pulley_radius*pulley_radius)/12.0}" iyz="0.0"
          izz="${arm_mass*(arm_length*arm_length+arm_width*arm_width)/12.0}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:crawler name="crawler_fr" x_sign="1"  y_sign="-1" material="sc_fr"/>
  <xacro:crawler name="crawler_fl" x_sign="1"  y_sign="1"  material="sc_fl"/>
  <xacro:crawler name="crawler_rr" x_sign="-1" y_sign="-1" material="sc_rr"/>
  <xacro:crawler name="crawler_rl" x_sign="-1" y_sign="1"  material="sc_rl"/>

  <!-- ─── Sitio para la IMU ───────────────────────────────────────────────
       En el TFG la MPU9250 iba en el frontal del chasis. Con PC a bordo lo
       recomendable es una IMU USB/I2C conectada al PC (imu_filter_madgwick).
       Este frame existe para poder publicar /imu/data con frame_id correcto.
  -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${base_length/2 - 0.05} 0 ${base_height/2}"/>
  </joint>
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.005"/></geometry>
      <material name="sc_sensor"/>
    </visual>
  </link>

</robot>
